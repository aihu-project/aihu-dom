{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@aihu/signals": ["./packages/signals/src/index.ts"],
      "@aihu/signals/lifecycle": ["./packages/signals/src/lifecycle.ts"],
      "@aihu/reactive": ["./packages/reactive/src/index.ts"],
      "@aihu/reactive/helpers": ["./packages/reactive/src/helpers/index.ts"],
      "@aihu/arbor": ["./packages/arbor/src/index.ts"],
      "@aihu/arbor/hydrate": ["./packages/arbor/src/hydrate.ts"],
      "@aihu/arbor/progressive": ["./packages/arbor/src/progressive.ts"]
    }
  }
}
